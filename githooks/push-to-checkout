#!/usr/bin/env bash
# Lands a push into the checkout that holds the branch, on `merge --ff-only`'s policy rather
# than git's whole-tree one. Git runs it for `git push . HEAD:<branch>` when the receiving
# repository has `receive.denyCurrentBranch = updateInstead`; the `lw-land` script relies on it.
#
# It refuses, and changes nothing, when a file the landing writes is uncommitted in that
# checkout: that is another session's work.
set -uo pipefail

# Git runs this inside `.git/worktrees/<pusher>`, which holds a file named HEAD, so every
# revision below is spelled with `--` or the name resolves to that file.

new=$1
cd "${GIT_WORK_TREE:-$(git rev-parse --show-toplevel)}" || exit 1

refuse() {
  echo "land: REFUSED. Nothing in this checkout was changed." >&2
  echo "land: $1" >&2
  while read -r path; do [[ -z $path ]] || echo "land:   $path" >&2; done <<<"${2:-}"
  echo "land: that is another session's work. Wait and land again; never stash, never restore it." >&2
  exit 1
}

git update-index -q --refresh >/dev/null 2>&1 || echo "land: the index refresh reported changes; checking paths one by one" >&2

# A peer's staging OUTSIDE the range survives `read-tree` untouched (measured), so it is not a
# reason to refuse. Inside the range it shows up as a difference from HEAD below.
range=$(git diff --name-only HEAD "$new" --)
if [[ -n $range ]]; then
  # The index and the working tree are asked separately. `git diff HEAD` reads the WORKING
  # TREE, so a path staged and then restored to HEAD's contents is invisible to it, and the
  # landing would write over an index entry its owner meant to keep.
  # shellcheck disable=SC2086
  dirty=$({
    git diff --name-only HEAD -- $range
    git diff --cached --name-only HEAD -- $range
  } | sort -u)
  [[ -z $dirty ]] || refuse "these files the landing writes are uncommitted here:" "$dirty"
fi

# `read-tree` writes over an ignored file, an ignored folder and an ignored file where a folder
# comes (measured, git 2.43), and an ignored file can hold a peer's private data. So every
# untracked or ignored path in the way of an added file refuses the landing.
in_the_way=""
while IFS= read -r path; do
  [[ -n $path ]] || continue
  if [[ -d $path && ! -L $path ]]; then
    [[ -z $(git ls-files --others -- "$path") ]] || in_the_way+="$path"$'\n'
    continue
  fi
  if [[ -e $path || -L $path ]]; then
    in_the_way+="$path"$'\n'
    continue
  fi
  dir=$path
  while [[ $dir == */* ]]; do
    dir=${dir%/*}
    if [[ -L $dir || (-e $dir && ! -d $dir) ]] && ! git cat-file -e "HEAD:$dir" 2>/dev/null; then
      in_the_way+="$dir"$'\n'
      break
    fi
  done
done <<<"$(git -c core.quotePath=false diff --name-only --no-renames --diff-filter=A HEAD "$new" --)"
[[ -z $in_the_way ]] ||
  refuse "these untracked or ignored paths are in the way of files the landing adds:" "$in_the_way"

git read-tree -u -m HEAD "$new" ||
  refuse "git could not write the working tree; an untracked file is in the way of an added path." ""
exit 0
